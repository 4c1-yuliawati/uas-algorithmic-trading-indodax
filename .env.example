# Required for persistent state/logs (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protect POST /api/tick; send as Authorization: Bearer <value>
CRON_SECRET=replace-with-a-long-random-secret

# Strategy and risk settings are frozen in src/config.ts, not changed via env.
# Set KILL_SWITCH in Upstash key bot:kill_switch to "1" to stop new orders.

# Higher official documented all-in fee rate (decimal, e.g. 0.00x); set only after fee audit
MIN_TAKER_FEE_RATE=
