
_SECTION_BEGIN("Trend Following");

// Parameter
FastPeriod = Param("EMA Cepat", 20, 5, 100, 1);
SlowPeriod = Param("EMA Lambat", 50, 10, 200, 1);
TrendPeriod = Param("EMA Tren", 200, 50, 300, 5);
ADXPeriod = Param("ADX Period", 14, 5, 30, 1);
MinADX = Param("Minimum ADX", 20, 10, 40, 1);

// Indikator
FastEMA = EMA(Close, FastPeriod);
SlowEMA = EMA(Close, SlowPeriod);
TrendEMA = EMA(Close, TrendPeriod);
ADXValue = ADX(ADXPeriod);

// Sinyal beli dan jual
Buy = Cross(FastEMA, SlowEMA)
      AND Close > TrendEMA
      AND ADXValue > MinADX;

Sell = Cross(SlowEMA, FastEMA);

// Hilangkan sinyal berulang
Buy = ExRem(Buy, Sell);
Sell = ExRem(Sell, Buy);

// Harga transaksi untuk backtest
SetTradeDelays(1, 1, 1, 1);
BuyPrice = Open;
SellPrice = Open;

// Tampilan chart
Plot(Close, "Harga", colorDefault, styleCandle);
Plot(FastEMA, "EMA Cepat", colorGreen, styleLine);
Plot(SlowEMA, "EMA Lambat", colorRed, styleLine);
Plot(TrendEMA, "EMA Tren", colorBlue, styleLine);

PlotShapes(IIf(Buy, shapeUpArrow, shapeNone),
           colorGreen, 0, Low, -15);
PlotShapes(IIf(Sell, shapeDownArrow, shapeNone),
           colorRed, 0, High, -15);

Title = Name() + " | Trend Following"
        + " | ADX: " + NumToStr(ADXValue, 1.2);

_SECTION_END();
